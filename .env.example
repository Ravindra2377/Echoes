DIARY_DB=diary.db
SYNC_INTERVAL_MIN=45
SYNC_SOURCES=ytmusic,spotify,amazon

# YouTube Music: headers file made by `ytmusicapi browser`
YTM_AUTH=browser.json

# Spotify (official API, dev mode is fine for one user)
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Amazon Music: Playwright session saved by `python -m scrapers.amazon login`
AMAZON_SESSION=amazon_session.json
AMAZON_URL=https://music.amazon.in/recents
